<mxfile host="app.diagrams.net">
  <diagram name="Kubernetes-Local" id="k8s-local">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="user" value="Usuario / Navegador" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="cluster" value="Cluster Kubernetes local (Kind / Minikube / Docker Desktop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2fb;strokeColor=#326CE5;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=8;dashed=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="280" y="40" width="900" height="560" as="geometry" />
        </mxCell>
        <mxCell id="ns" value="Namespace: oficina-mecanica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326CE5;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=6;fontColor=#000000;" vertex="1" parent="1">
