        <mxCell id="svcdb" value="Service&#10;sqlserver&#10;ClusterIP :1433" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#1a3f8f;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
