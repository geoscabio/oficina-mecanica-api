          <mxGeometry x="465" y="440" width="115" height="50" as="geometry" />
        </mxCell>

        <mxCell id="hpa" value="HorizontalPodAutoscaler&#10;oficina-mecanica-api-hpa&#10;min 1 / max 5, CPU 70% / Mem 80%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="640" y="330" width="220" height="80" as="geometry" />
