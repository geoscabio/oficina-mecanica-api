          <mxGeometry x="340" y="240" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="depapi" value="Deployment&#10;oficina-mecanica-api&#10;(Pods, 1 a 5 replicas)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#1a3f8f;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="330" width="240" height="80" as="geometry" />
