        <mxCell id="e-cm-dep" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;dashed=1;fontColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cm" target="depapi"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-sec-dep" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;dashed=1;fontColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="secapi" target="depapi"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-hpa-dep" value="escala conforme&#10;CPU/memoria" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#d6b656;dashed=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="hpa" target="depapi"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-dep-svcdb" value="acesso ao banco&#10;porta 1433" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="depapi" target="svcdb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-svcdb-depdb" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="svcdb" target="depdb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-pvc-depdb" value="persiste dados" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;dashed=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pvc" target="depdb"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-secdb-depdb" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;dashed=1;fontColor=#000000;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="secdb" target="depdb"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="Setas solidas = trafego real | Setas pontilhadas = configuracao/gerenciamento" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
