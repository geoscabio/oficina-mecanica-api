        </mxCell>

        <mxCell id="ing" value="Ingress&#10;oficina-mecanica-api&#10;host: oficina-mecanica.local (nginx)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#1a3f8f;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1">
