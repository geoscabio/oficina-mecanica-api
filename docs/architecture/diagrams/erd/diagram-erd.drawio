        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    MECANICOS ||--o{ ORDENSSERVICO : \&quot;executa\&quot;\n    VEICULOS ||--o{ ORDENSSERVICO : \&quot;é atendido em\&quot;\n    CLIENTES ||--o{ VEICULOS : \&quot;possui\&quot;\n    ESTOQUES ||--o{ ITENSESTOQUE : \&quot;contem\&quot;\n    PECASINSUMOSCATALOGO ||--o| ITENSESTOQUE : \&quot;tem estoque de\&quot;\n    PECASINSUMOSCATALOGO ||--o{ PECASINSUMOSORDEMSERVICO : \&quot;e usada em\&quot;\n    ORDENSSERVICO ||--o{ PECASINSUMOSORDEMSERVICO : \&quot;consome\&quot;\n    SERVICOSCATALOGO ||--o{ SERVICOSORDEMSERVICO : \&quot;e usado em\&quot;\n    ORDENSSERVICO ||--o{ SERVICOSORDEMSERVICO : \&quot;inclui\&quot;\n\n    MECANICOS {\n        uniqueidentifier Id PK\n        nvarchar_30 Funcional\n        nvarchar_120 Nome\n    }\n\n    PECASINSUMOSCATALOGO {\n        uniqueidentifier Id PK\n        nvarchar_160 Descricao\n        int Tipo\n        decimal_18_2 Valor\n    }\n\n    SERVICOSCATALOGO {\n        uniqueidentifier Id PK\n        nvarchar_160 Descricao\n        decimal_18_2 Valor\n    }\n\n    CLIENTES {\n        uniqueidentifier Id PK\n        nvarchar_160 Nome\n        int Status\n        nvarchar_14 Documento UK\n        int TipoDocumento\n        nvarchar_160 Email\n        nvarchar_120 EnderecoBairro\n        nvarchar_8 EnderecoCEP\n        nvarchar_120 EnderecoCidade\n        nvarchar_160 EnderecoLogradouro\n        nvarchar_20 EnderecoNumero\n        nvarchar_11 Telefone\n    }\n\n    VEICULOS {\n        uniqueidentifier Id PK\n        int Ano\n        uniqueidentifier ClienteId FK\n        nvarchar_80 Marca\n        nvarchar_80 Modelo\n        nvarchar_7 Placa UK\n    }\n\n    ESTOQUES {\n        uniqueidentifier Id PK\n    }\n\n    ITENSESTOQUE {\n        uniqueidentifier Id PK\n        uniqueidentifier EstoqueId FK\n        uniqueidentifier PecaInsumoCatalogoId FK_UK\n        int QuantidadeDisponivel\n        int QuantidadeReservada\n        rowversion RowVersion\n    }\n\n    ORDENSSERVICO {\n        uniqueidentifier Id PK\n        datetime2 DataFim\n        datetime2 DataInicio\n        uniqueidentifier MecanicoId FK\n        int MotivoCancelamento\n        int Numero UK\n        rowversion RowVersion\n        int Status\n        decimal_18_2 ValorTotal\n        uniqueidentifier VeiculoId FK\n    }\n\n    PECASINSUMOSORDEMSERVICO {\n        uniqueidentifier Id PK\n        uniqueidentifier OrdemServicoId FK\n        uniqueidentifier PecaInsumoCatalogoId FK\n        int Quantidade\n        decimal_18_2 ValorUnitario\n    }\n\n    SERVICOSORDEMSERVICO {\n        uniqueidentifier Id PK\n        datetime2 DataFim\n        datetime2 DataInicio\n        uniqueidentifier OrdemServicoId FK\n        uniqueidentifier ServicoCatalogoId FK\n        int Status\n        decimal_18_2 Valor\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EEMifNFpzkEnxHb5lvvW-1">
