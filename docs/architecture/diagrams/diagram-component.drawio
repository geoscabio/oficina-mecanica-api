        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n\n  Client[\&quot;Cliente&lt;br/&gt;&lt;small&gt;Navegador / App&lt;/small&gt;\&quot;]:::client\n  Gateway[\&quot;Amazon API Gateway&lt;br/&gt;&lt;small&gt;REST API&lt;br/&gt;Entrada pública e roteamento&lt;/small&gt;\&quot;]:::gateway\n  Auth[\&quot;oficina-mecanica-auth-lambda&lt;br/&gt;&lt;small&gt;Autenticação por CPF&lt;br/&gt;Validação do CPF e geração do JWT&lt;/small&gt;\&quot;]:::lambda\n\n  subgraph AWS[\&quot;AWS Cloud\&quot;]\n    direction LR\n    subgraph VPC[\&quot;VPC — Rede privada\&quot;]\n      direction LR\n      Link[\&quot;VPC Link&lt;br/&gt;&lt;small&gt;Integração privada&lt;/small&gt;\&quot;]:::vpc\n      NLB[\&quot;NLB interno&lt;br/&gt;&lt;small&gt;Network Load Balancer&lt;/small&gt;\&quot;]:::nlb\n      subgraph EKS[\&quot;Amazon EKS&lt;br/&gt;&lt;small&gt;Kubernetes — Execução da API&lt;/small&gt;\&quot;]\n        direction TB\n        KService[\&quot;Kubernetes Service\&quot;]:::eks\n        API[\&quot;oficina-mecanica-api&lt;br/&gt;&lt;small&gt;(ASP.NET Core)&lt;br/&gt;Validação do JWT nas APIs protegidas&lt;/small&gt;\&quot;]:::eks\n        HPA[\&quot;HPA&lt;br/&gt;&lt;small&gt;Escalabilidade da aplicação&lt;/small&gt;\&quot;]:::eks\n        KService --&gt; API\n        HPA -.-&gt; API\n      end\n    end\n    RDS[\&quot;Amazon RDS&lt;br/&gt;&lt;small&gt;SQL Server&lt;br/&gt;Banco de dados da aplicação&lt;/small&gt;\&quot;]:::rds\n  end\n\n  ECR[\&quot;Amazon ECR&lt;br/&gt;&lt;small&gt;Repositório de imagens Docker&lt;/small&gt;\&quot;]:::ecr\n  Actions[\&quot;GitHub Actions&lt;br/&gt;&lt;small&gt;CI/CD&lt;/small&gt;\&quot;]:::cicd\n  DD[\&quot;Datadog&lt;br/&gt;&lt;small&gt;Monitoramento e Observabilidade&lt;/small&gt;\&quot;]:::datadog\n\n  Client --&gt;|\&quot;Consome APIs\&quot;| Gateway\n  Gateway --&gt;|\&quot;/auth/cpf\&quot;| Auth\n  Auth --&gt;|\&quot;Consulta cliente por CPF\&quot;| RDS\n  Auth -.-&gt;|\&quot;JWT ou 401\&quot;| Gateway\n  Gateway --&gt;|\&quot;/api/*\&quot;| Link\n  Link --&gt;|\&quot;Conexão privada\&quot;| NLB\n  NLB --&gt;|\&quot;Distribuição de tráfego\&quot;| API\n  API --&gt;|\&quot;Acesso aos dados\&quot;| RDS\n  Actions -.-&gt;|\&quot;Build e push da imagem\&quot;| ECR\n  ECR -.-&gt;|\&quot;Imagem Docker\&quot;| API\n\n  DD -.-&gt;|\&quot;Métricas / Logs / Traces\&quot;| Gateway\n  DD -.-&gt;|\&quot;Métricas / Logs / Traces\&quot;| Auth\n  DD -.-&gt;|\&quot;Métricas / Logs / Traces\&quot;| EKS\n  DD -.-&gt;|\&quot;Métricas / Logs / Traces\&quot;| API\n  DD -.-&gt;|\&quot;Métricas / Logs / Traces\&quot;| RDS\n\n  subgraph F1[\&quot;Fluxo 1 — Autenticação por CPF&lt;br/&gt;&lt;small&gt;POST /auth/cpf&lt;/small&gt;\&quot;]\n    direction TB\n    F1Text[\&quot;Cliente → API Gateway → Auth Lambda → RDS&lt;br/&gt;Retorno: Auth Lambda → API Gateway → Cliente\&quot;]:::info\n  end\n\n  subgraph F2[\&quot;Fluxo 2 — Abertura de Ordem de Serviço&lt;br/&gt;&lt;small&gt;POST /api/v1/gestao-ordem-servico/ordens-servico/cadastrar&lt;br/&gt;+ JWT&lt;/small&gt;\&quot;]\n    direction TB\n    F2Text[\&quot;Cliente → API Gateway → VPC Link → NLB interno → oficina-mecanica-api → RDS\&quot;]:::info\n  end\n\n  subgraph Responsibilities[\&quot;Principais responsabilidades\&quot;]\n    direction TB\n    Resp[\&quot;Amazon API Gateway: Entrada pública e roteamento das APIs&lt;br/&gt;Auth Lambda: Autenticação por CPF e geração de JWT&lt;br/&gt;VPC Link: Integração privada com a VPC&lt;br/&gt;NLB: Distribuição de tráfego interno&lt;br/&gt;EKS: Execução da API&lt;br/&gt;ECR: Armazenamento das imagens Docker&lt;br/&gt;RDS: Persistência dos dados&lt;br/&gt;Datadog: Monitoramento e observabilidade&lt;br/&gt;GitHub Actions: Build e push das imagens\&quot;]:::info\n  end\n\n  subgraph Legend[\&quot;Legenda\&quot;]\n    direction TB\n    Leg[\&quot;🔵 Fluxo 1 — Autenticação por CPF&lt;br/&gt;🟢 Fluxo 2 — Abertura de Ordem de Serviço&lt;br/&gt;→ Fluxo funcional / requisição&lt;br/&gt;- - → Resposta / integração / observabilidade&lt;br/&gt;🔴 Monitoramento — Datadog&lt;br/&gt;⚫ CI/CD — GitHub Actions\&quot;]:::legend\n  end\n\n  linkStyle 0,1,2,3,4,5,6,7 stroke:#2563eb,stroke-width:2px\n  linkStyle 8,9,10,11,12 stroke:#16a34a,stroke-width:2px\n  linkStyle 13,14,15,16,17 stroke:#dc2626,stroke-width:2px,stroke-dasharray:6 4\n  linkStyle 18,19 stroke:#6b7280,stroke-width:2px,stroke-dasharray:6 4\n  linkStyle 20 stroke:#64748b,stroke-width:1px,stroke-dasharray:4 3\n  linkStyle 21 stroke:#64748b,stroke-width:1px,stroke-dasharray:4 3\n  linkStyle 22 stroke:#64748b,stroke-width:1px,stroke-dasharray:4 3\n  linkStyle 23 stroke:#64748b,stroke-width:1px,stroke-dasharray:4 3\n  linkStyle 24 stroke:#64748b,stroke-width:1px,stroke-dasharray:4 3\n  linkStyle 25,26,27,28,29,30 stroke:transparent,stroke-width:0px&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="2">
