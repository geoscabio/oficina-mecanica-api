<mxfile host="app.diagrams.net">
  <diagram name="CI-CD" id="cicd-pipeline">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="branch" value="feature/*, bugfix/*, hotfix/*&#10;PR manual para develop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ci" value="CI&#10;(.github/workflows/ci.yml)&#10;Trigger: pull_request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#24292e;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=6;fontColor=#000000;" vertex="1" parent="1">
