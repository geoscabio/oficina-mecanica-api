<mxfile host="app.diagrams.net">
  <diagram name="CI-CD" id="cicd-pipeline">
    <mxGraphModel dx="2200" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="1050" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="branch" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontColor=#000000;" value="feature/*, bugfix/*, hotfix/*&#xa;PR manual para develop&#xa;(GitHub)" vertex="1">
          <mxGeometry height="60" width="200" x="20" y="340" as="geometry" />
        </mxCell>

        <mxCell id="ci" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#24292e;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=6;fontColor=#000000;" value="CI (.github/workflows/ci.yml)&#xa;Trigger: pull_request&#xa;Valida ANTES do merge — nao faz deploy" vertex="1">
          <mxGeometry height="440" width="260" x="280" y="40" as="geometry" />
        </mxCell>
        <mxCell id="ci1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;fontColor=#000000;" value="build_application&#xa;Restore + build" vertex="1">
          <mxGeometry height="45" width="220" x="300" y="120" as="geometry" />
        </mxCell>
        <mxCell id="ci2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;fontColor=#000000;" value="verify_code_style&#xa;dotnet format" vertex="1">
          <mxGeometry height="45" width="220" x="300" y="175" as="geometry" />
        </mxCell>
        <mxCell id="ci3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontColor=#000000;" value="test_application&#xa;Testes + cobertura minima 90%" vertex="1">
          <mxGeometry height="45" width="220" x="300" y="230" as="geometry" />
        </mxCell>
        <mxCell id="ci4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f0fa;strokeColor=#2496ED;fontSize=11;fontColor=#000000;" value="build_container_image&#xa;Build imagem Docker (validacao, sem push)" vertex="1">
          <mxGeometry height="45" width="220" x="300" y="285" as="geometry" />
        </mxCell>
        <mxCell id="ci5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8edfb;strokeColor=#326CE5;fontSize=11;fontColor=#000000;" value="validate_kubernetes_manifests&#xa;Dry-run em cluster KinD efemero" vertex="1">
          <mxGeometry height="45" width="220" x="300" y="340" as="geometry" />
        </mxCell>
        <mxCell id="ci6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;fontColor=#000000;" value="quality_gate&#xa;Consolida os jobs anteriores" vertex="1">
          <mxGeometry height="45" width="220" x="300" y="395" as="geometry" />
        </mxCell>
        <mxCell id="e-ci-steps1" edge="1" parent="1" source="ci1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontColor=#000000;labelBackgroundColor=#ffffff;" target="ci2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-ci-steps2" edge="1" parent="1" source="ci2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontColor=#000000;labelBackgroundColor=#ffffff;" target="ci3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-ci-steps3" edge="1" parent="1" source="ci3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontColor=#000000;labelBackgroundColor=#ffffff;" target="ci4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-ci-steps4" edge="1" parent="1" source="ci4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontColor=#000000;labelBackgroundColor=#ffffff;" target="ci5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-ci-steps5" edge="1" parent="1" source="ci5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontColor=#000000;labelBackgroundColor=#ffffff;" target="ci6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="cddev" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#24292e;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=6;fontColor=#000000;" value="CD Development (cd-development.yml)&#xa;Trigger: push em develop&#xa;Unico fluxo que provisiona AWS real" vertex="1">
          <mxGeometry height="840" width="560" x="600" y="40" as="geometry" />
        </mxCell>
        <mxCell id="cd0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;fontColor=#000000;" value="Detecta mudanca deployable&#xa;(pula deploy se for so docs/Markdown)" vertex="1">
          <mxGeometry height="50" width="520" x="620" y="90" as="geometry" />
        </mxCell>

        <mxCell id="reusable" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0ff;strokeColor=#666666;strokeWidth=2;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=6;fontColor=#000000;" value="chama workflow reutilizavel: aws-deploy.yml" vertex="1">
          <mxGeometry height="570" width="520" x="620" y="160" as="geometry" />
        </mxCell>
        <mxCell id="r1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;fontColor=#000000;" value="1. Resolve TERRAFORM_ACTION&#xa;(le terraform-action.env)" vertex="1">
          <mxGeometry height="45" width="480" x="640" y="200" as="geometry" />
        </mxCell>
        <mxCell id="r2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;fontColor=#000000;" value="2. Prepara variaveis + restaura/cacheia&#xa;Terraform state (GitHub Actions cache)" vertex="1">
          <mxGeometry height="45" width="480" x="640" y="255" as="geometry" />
        </mxCell>
        <mxCell id="r3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#ED7100;fontSize=11;fontColor=#000000;" value="3. Garante o ECR + gera plano Terraform&#xa;publica plano como artefato" vertex="1">
          <mxGeometry height="45" width="480" x="640" y="310" as="geometry" />
        </mxCell>
        <mxCell id="decision" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontColor=#000000;" value="TERRAFORM_ACTION?" vertex="1">
          <mxGeometry height="80" width="150" x="805" y="365" as="geometry" />
        </mxCell>

        <mxCell id="d1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontColor=#000000;" value="destroy&#xa;Terraform destroy&#xa;(caminho destrutivo)" vertex="1">
          <mxGeometry height="60" width="200" x="640" y="470" as="geometry" />
        </mxCell>
        <mxCell id="a1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f0fa;strokeColor=#2496ED;fontSize=11;fontColor=#000000;" value="apply&#xa;Build e push da imagem&#xa;Amazon ECR" vertex="1">
          <mxGeometry height="60" width="200" x="880" y="470" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5d0;strokeColor=#7B42BC;fontSize=11;fontColor=#000000;" value="Terraform apply&#xa;VPC, RDS, EKS, workload K8s" vertex="1">
          <mxGeometry height="60" width="200" x="880" y="545" as="geometry" />
        </mxCell>
        <mxCell id="a3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8edfb;strokeColor=#326CE5;fontSize=11;fontColor=#000000;" value="Valida rollout no EKS&#xa;instala/valida metrics-server&#xa;imprime endpoint do Load Balancer" vertex="1">
          <mxGeometry height="70" width="200" x="880" y="620" as="geometry" />
        </mxCell>

        <mxCell id="r4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;fontColor=#000000;" value="4. Salva Terraform state atualizado&#xa;(cache GitHub Actions, mesmo se falhar depois)" vertex="1">
          <mxGeometry height="50" width="480" x="640" y="710" as="geometry" />
        </mxCell>

        <mxCell id="cd7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24292e;strokeColor=#000000;fontColor=#ffffff;fontStyle=1;fontSize=11;" value="Abre PR automatico develop -&gt; release&#xa;(GitHub, so se apply passou ou so docs)" vertex="1">
          <mxGeometry height="50" width="520" x="620" y="790" as="geometry" />
        </mxCell>

        <mxCell id="e-r1" edge="1" parent="1" source="r1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontColor=#000000;labelBackgroundColor=#ffffff;" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-r2" edge="1" parent="1" source="r2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontColor=#000000;labelBackgroundColor=#ffffff;" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-r3" edge="1" parent="1" source="r3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontColor=#000000;labelBackgroundColor=#ffffff;" target="decision"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-dec-d1" edge="1" parent="1" source="decision" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;" target="d1" value="destroy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-dec-a1" edge="1" parent="1" source="decision" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;" target="a1" value="apply">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-a1-a2" edge="1" parent="1" source="a1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontColor=#000000;labelBackgroundColor=#ffffff;" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-a2-a3" edge="1" parent="1" source="a2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontColor=#000000;labelBackgroundColor=#ffffff;" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-d1-r4" edge="1" parent="1" source="d1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;fontColor=#000000;labelBackgroundColor=#ffffff;" target="r4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-a3-r4" edge="1" parent="1" source="a3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontColor=#000000;labelBackgroundColor=#ffffff;" target="r4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-r4-pr" edge="1" parent="1" source="r4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;" target="cd7" value="so segue se action=apply&#xa;(destroy encerra aqui)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="awsicons" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;fontStyle=1;" value="Recursos AWS reais criados/afetados por este workflow:" vertex="1">
          <mxGeometry height="20" width="300" x="1110" y="470" as="geometry" />
        </mxCell>
        <mxCell id="icon-ecr" parent="1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" value="ECR" vertex="1">
          <mxGeometry height="50" width="50" x="1110" y="500" as="geometry" />
