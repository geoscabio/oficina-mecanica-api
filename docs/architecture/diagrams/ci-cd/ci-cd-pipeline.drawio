        <mxCell id="icon-eks" parent="1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eks;" value="EKS" vertex="1">
          <mxGeometry height="50" width="50" x="1180" y="500" as="geometry" />
        </mxCell>
        <mxCell id="icon-rds" parent="1" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" value="RDS" vertex="1">
          <mxGeometry height="50" width="50" x="1110" y="560" as="geometry" />
        </mxCell>
        <mxCell id="icon-lb" parent="1" style="outlineConnect=0;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=9;shape=mxgraph.aws3.classic_load_balancer;fillColor=#F58536;gradientColor=none;" value="Load Balancer" vertex="1">
          <mxGeometry height="50" width="50" x="1180" y="560" as="geometry" />
        </mxCell>

        <mxCell id="cdrel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#24292e;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=6;fontColor=#000000;" value="CD Release (cd-release.yml)&#xa;Trigger: push em release&#xa;Deploy logico — sem provisionar AWS" vertex="1">
          <mxGeometry height="200" width="260" x="1300" y="40" as="geometry" />
        </mxCell>
        <mxCell id="cr1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;fontColor=#000000;" value="Registra deploy logico&#xa;homologation" vertex="1">
          <mxGeometry height="50" width="220" x="1320" y="100" as="geometry" />
        </mxCell>
        <mxCell id="cr2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24292e;strokeColor=#000000;fontColor=#ffffff;fontStyle=1;fontSize=11;" value="Abre PR automatico&#xa;release -&gt; main" vertex="1">
          <mxGeometry height="50" width="220" x="1320" y="165" as="geometry" />
        </mxCell>
        <mxCell id="e-cr1" edge="1" parent="1" source="cr1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;fontColor=#000000;labelBackgroundColor=#ffffff;" target="cr2"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="cdprod" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#24292e;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=6;fontColor=#000000;" value="CD Production (cd-production.yml)&#xa;Trigger: push em main&#xa;Deploy logico — sem provisionar AWS" vertex="1">
          <mxGeometry height="160" width="260" x="1300" y="280" as="geometry" />
        </mxCell>
        <mxCell id="cp1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;fontColor=#000000;" value="Registra deploy logico&#xa;production&#xa;(PR exige aprovacao humana)" vertex="1">
          <mxGeometry height="80" width="220" x="1320" y="340" as="geometry" />
        </mxCell>

        <mxCell id="emergency" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;dashed=1;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=6;fontColor=#000000;" value="AWS Import Existing Resources (aws-import-existing-resources.yml)&#xa;Trigger: workflow_dispatch (manual) — trilha de EMERGENCIA, fora do fluxo normal" vertex="1">
          <mxGeometry height="120" width="1080" x="20" y="920" as="geometry" />
        </mxCell>
        <mxCell id="em1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;fontColor=#000000;" value="Usado so quando terraform apply/destroy falha&#xa;porque o state (cache) esta desalinhado da AWS real.&#xa;Descobre recursos via AWS CLI, roda terraform import,&#xa;termina em um plan para revisao humana (nunca aplica sozinho)." vertex="1">
          <mxGeometry height="70" width="1040" x="40" y="960" as="geometry" />
        </mxCell>
        <mxCell id="e-emergency-state" edge="1" parent="1" source="emergency" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#b85450;dashed=1;fontSize=10;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" target="r4" value="reconcilia o mesmo state&#xa;(emergencial, nao automatico)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-branch-ci" edge="1" parent="1" source="branch" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=11;fontColor=#000000;labelBackgroundColor=#ffffff;" target="ci"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e-ci-cddev" edge="1" parent="1" source="ci" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=11;fontColor=#000000;labelBackgroundColor=#ffffff;" target="cddev" value="merge revisado&#xa;(develop)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cddev-cdrel" edge="1" parent="1" source="cddev" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=11;fontColor=#000000;labelBackgroundColor=#ffffff;" target="cdrel" value="PR automatico +&#xa;merge revisado">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cdrel-cdprod" edge="1" parent="1" source="cdrel" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=11;fontColor=#000000;labelBackgroundColor=#ffffff;" target="cdprod" value="PR automatico +&#xa;merge com aprovacao&#xa;obrigatoria">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="legend" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#333333;" value="Legenda: preta solida = fluxo/execucao | cinza pontilhada = cache/artefato | amarela = decisao | vermelha = caminho destrutivo/emergencial. Cores: cinza/preto=GitHub, azul=Docker, azul-escuro=Kubernetes/EKS, roxo=Terraform, laranja=AWS, verde=qualidade." vertex="1">
          <mxGeometry height="40" width="1080" x="20" y="1050" as="geometry" />
        </mxCell>
      </root>
