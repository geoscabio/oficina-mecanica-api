@startuml
title <size:24>System Landscape View</size>\n<size:24>Nivel 0 - paisagem de sistemas e plataformas relacionadas.</size>

set separator none
left to right direction
skinparam ranksep 20
skinparam nodesep 5
hide stereotype

<style>
  root {
    BackgroundColor: #ffffff;
    FontColor: #444444;
  }
  // Element,Person
  .Element-RWxlbWVudCxQZXJzb24= {
    BackgroundColor: #08427b;
    LineColor: #052e56;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0= {
    BackgroundColor: #1168bd;
    LineColor: #0b4884;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,AWS,Planned
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sQVdTLFBsYW5uZWQ= {
    BackgroundColor: #ff9900;
    LineColor: #b26b00;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #000000;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,AWS,Registry
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sQVdTLFJlZ2lzdHJ5 {
    BackgroundColor: #cc7a00;
    LineColor: #8e5500;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #000000;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Element,Software System,Core System
  .Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sQ29yZSBTeXN0ZW0= {
    BackgroundColor: #0b7285;
    LineColor: #074f5d;
    LineStyle: 0;
    LineThickness: 2;
    FontColor: #ffffff;
    FontSize: 24;
    HorizontalAlignment: center;
    Shadowing: 0;
    MaximumWidth: 450;
  }
  // Relationship
  .Relationship-UmVsYXRpb25zaGlw {
    LineThickness: 2;
    LineStyle: 10-10;
    LineColor: #495057;
    FontColor: #495057;
    FontSize: 24;
    MaximumWidth: 200;
  }
</style>

person "==Cliente\n<size:16>[Person]</size>\n\nConsulta o status publico de uma ordem de servico." <<Element-RWxlbWVudCxQZXJzb24=>> as Cliente
rectangle "==Amazon ECR oficina-api\n<size:16>[Software System]</size>\n\nRepositorio privado com tags imutaveis e scan on push, provisionado pelo modulo Terraform registry." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sQVdTLFJlZ2lzdHJ5>> as AmazonECRoficinaapi
rectangle "==Manifestos Kubernetes\n<size:16>[Software System]</size>\n\nDeployment, Service, Ingress, HPA, ConfigMap, Secrets, PVC e namespace oficina." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as ManifestosKubernetes
rectangle "==AWS\n<size:16>[Software System]</size>\n\nConta de desenvolvimento com VPC e ECR provisionados por Terraform; EKS e RDS estao planejados nas proximas etapas." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sQVdTLFBsYW5uZWQ=>> as AWS
rectangle "==Oficina Mecanica API\n<size:16>[Software System]</size>\n\nSistema de atendimento, execucao e acompanhamento de ordens de servico para uma oficina mecanica." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0sQ29yZSBTeXN0ZW0=>> as OficinaMecanicaAPI
person "==Atendente\n<size:16>[Person]</size>\n\nCadastra clientes e veiculos, abre ordens de servico, envia orcamentos e registra entregas." <<Element-RWxlbWVudCxQZXJzb24=>> as Atendente
person "==Mecanico\n<size:16>[Person]</size>\n\nExecuta diagnostico, define servicos, reserva pecas e finaliza trabalhos." <<Element-RWxlbWVudCxQZXJzb24=>> as Mecanico
person "==Administrador\n<size:16>[Person]</size>\n\nMantem cadastros administrativos e apoia a operacao." <<Element-RWxlbWVudCxQZXJzb24=>> as Administrador
rectangle "==Canal externo de orcamento\n<size:16>[Software System]</size>\n\nCanal externo usado para enviar orcamento ao cliente e notificar aprovacao ou recusa via webhook." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Canalexternodeorcamento
rectangle "==GitHub\n<size:16>[Software System]</size>\n\nRepositorio privado usado para versionamento e Pull Requests." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as GitHub
rectangle "==Docker Hub\n<size:16>[Software System]</size>\n\nRegistry usado hoje pelos manifestos Kubernetes locais para a imagem gbsousadev/oficina-api:1.0." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as DockerHub
rectangle "==Terraform dev\n<size:16>[Software System]</size>\n\nCodigo de infraestrutura que provisiona VPC, subnets publicas/privadas, route tables, internet gateway e ECR." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Terraformdev
rectangle "==Imagem Docker oficina-api\n<size:16>[Software System]</size>\n\nArtefato OCI gerado pelo Dockerfile multi-stage da API." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as ImagemDockeroficinaapi

Atendente --> OficinaMecanicaAPI <<Relationship-UmVsYXRpb25zaGlw>> : "Usa para atendimento, abertura de OS, aprovacoes e entrega\n<size:16>[HTTPS/JSON]</size>"
Mecanico --> OficinaMecanicaAPI <<Relationship-UmVsYXRpb25zaGlw>> : "Usa para diagnostico, reserva de pecas e execucao de servicos\n<size:16>[HTTPS/JSON]</size>"
Administrador --> OficinaMecanicaAPI <<Relationship-UmVsYXRpb25zaGlw>> : "Mantem cadastros administrativos\n<size:16>[HTTPS/JSON]</size>"
Cliente --> OficinaMecanicaAPI <<Relationship-UmVsYXRpb25zaGlw>> : "Consulta status publico da ordem de servico\n<size:16>[HTTPS/JSON]</size>"
Atendente --> Canalexternodeorcamento <<Relationship-UmVsYXRpb25zaGlw>> : "Envia orcamento ao cliente por canal externo\n<size:16>[Manual/externo]</size>"
Canalexternodeorcamento --> OficinaMecanicaAPI <<Relationship-UmVsYXRpb25zaGlw>> : "Notifica decisao do orcamento\n<size:16>[Webhook HTTP com X-Webhook-Token]</size>"
GitHub --> Terraformdev <<Relationship-UmVsYXRpb25zaGlw>> : "Versiona codigo de infraestrutura\n<size:16>[Git]</size>"
GitHub --> ManifestosKubernetes <<Relationship-UmVsYXRpb25zaGlw>> : "Versiona manifestos\n<size:16>[Git]</size>"
Terraformdev --> AWS <<Relationship-UmVsYXRpb25zaGlw>> : "Provisiona recursos dev\n<size:16>[Terraform AWS provider]</size>"
ImagemDockeroficinaapi --> DockerHub <<Relationship-UmVsYXRpb25zaGlw>> : "Imagem publicada para uso local atual\n<size:16>[Docker push]</size>"
ImagemDockeroficinaapi --> AmazonECRoficinaapi <<Relationship-UmVsYXRpb25zaGlw>> : "Imagem planejada para pipeline AWS\n<size:16>[Docker push]</size>"
ManifestosKubernetes --> DockerHub <<Relationship-UmVsYXRpb25zaGlw>> : "Referencia imagem atual gbsousadev/oficina-api:1.0\n<size:16>[imagePull]</size>"

@enduml