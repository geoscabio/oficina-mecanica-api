person "==Cliente\n<size:16>[Person]</size>\n\nConsulta o status publico de uma ordem de servico." <<Element-RWxlbWVudCxQZXJzb24=>> as Cliente
person "==Atendente\n<size:16>[Person]</size>\n\nCadastra clientes e veiculos, abre ordens de servico, envia orcamentos e registra entregas." <<Element-RWxlbWVudCxQZXJzb24=>> as Atendente
person "==Mecanico\n<size:16>[Person]</size>\n\nExecuta diagnostico, define servicos, reserva pecas e finaliza trabalhos." <<Element-RWxlbWVudCxQZXJzb24=>> as Mecanico
person "==Administrador\n<size:16>[Person]</size>\n\nMantem cadastros administrativos e apoia a operacao." <<Element-RWxlbWVudCxQZXJzb24=>> as Administrador
rectangle "==Canal externo de orcamento\n<size:16>[Software System]</size>\n\nCanal externo usado para enviar orcamento ao cliente e notificar aprovacao ou recusa via webhook." <<Element-RWxlbWVudCxTb2Z0d2FyZSBTeXN0ZW0=>> as Canalexternodeorcamento

rectangle "Oficina Mecanica API\n<size:16>[Software System]</size>" <<Boundary-T2ZpY2luYSBNZWNhbmljYSBBUEk=>> {
  rectangle "==OficinaMecanica.API\n<size:16>[Container: ASP.NET Core Web API / .NET 10]</size>\n\nMonolito modular ASP.NET Core que expoe endpoints REST, Swagger, autenticacao JWT, webhook de orcamento e inicializacao do banco." <<Element-RWxlbWVudCxDb250YWluZXIsQVBJ>> as OficinaMecanicaAPI.OficinaMecanicaAPI
  database "==OficinaMecanicaDb\n<size:16>[Container: SQL Server 2022]</size>\n\nBanco relacional da aplicacao, criado localmente por Docker Compose/Kubernetes e acessado via EF Core." <<Element-RWxlbWVudCxDb250YWluZXIsRGF0YWJhc2U=>> as OficinaMecanicaAPI.OficinaMecanicaDb
}

Atendente --> OficinaMecanicaAPI.OficinaMecanicaAPI <<Relationship-UmVsYXRpb25zaGlw>> : "Usa para atendimento, abertura de OS, aprovacoes e entrega\n<size:16>[HTTPS/JSON]</size>"
Mecanico --> OficinaMecanicaAPI.OficinaMecanicaAPI <<Relationship-UmVsYXRpb25zaGlw>> : "Usa para diagnostico, reserva de pecas e execucao de servicos\n<size:16>[HTTPS/JSON]</size>"
Administrador --> OficinaMecanicaAPI.OficinaMecanicaAPI <<Relationship-UmVsYXRpb25zaGlw>> : "Mantem cadastros administrativos\n<size:16>[HTTPS/JSON]</size>"
Cliente --> OficinaMecanicaAPI.OficinaMecanicaAPI <<Relationship-UmVsYXRpb25zaGlw>> : "Consulta status publico da ordem de servico\n<size:16>[HTTPS/JSON]</size>"
Atendente --> Canalexternodeorcamento <<Relationship-UmVsYXRpb25zaGlw>> : "Envia orcamento ao cliente por canal externo\n<size:16>[Manual/externo]</size>"
