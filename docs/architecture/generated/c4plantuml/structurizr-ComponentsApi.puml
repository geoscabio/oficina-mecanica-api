@startuml
title <size:24>Component View: Oficina Mecanica API - OficinaMecanica.API</size>\n<size:24>Nivel 3 - componentes principais do monolito modular.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

System_Boundary("OficinaMecanicaAPI_boundary", "Oficina Mecanica API", $tags="") {
  Container_Boundary("OficinaMecanicaAPI.OficinaMecanicaAPI_boundary", "OficinaMecanica.API", $tags="") {
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.ControllersHTTP, "Controllers HTTP", $techn="ASP.NET Core MVC Controllers", $descr="Adaptadores de entrada para Identidade, Atendimento, Administrativo, Gestao de Estoque e Gestao de Ordem de Servico.", $tags="", $link="")
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.Segurancaemiddlewares, "Seguranca e middlewares", $techn="ASP.NET Core middleware", $descr="Configura autenticacao JWT, autorizacao por perfis, token tecnico de webhook, Swagger e tratamento global de excecoes.", $tags="", $link="")
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.ApplicationUseCases, "Application Use Cases", $techn="C# / FluentValidation / AutoMapper", $descr="Orquestra casos de uso, validacoes, mapeamentos e transacoes de aplicacao.", $tags="", $link="")
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.DomainModel, "Domain Model", $techn="C# domain model", $descr="Contem agregados, entidades, value objects, enums, regras de negocio e contratos de repositories.", $tags="", $link="")
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.Infrastructureadapters, "Infrastructure adapters", $techn="C# / EF Core / SQL Server", $descr="Implementa repositories, EF Core, Unit of Work, migrations, seed, servicos JWT e usuario demo.", $tags="", $link="")
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.OficinaMecanicaDbContext, "OficinaMecanicaDbContext", $techn="Entity Framework Core DbContext", $descr="Mapeia os agregados e entidades para tabelas SQL Server.", $tags="", $link="")
  }

  ContainerDb(OficinaMecanicaAPI.OficinaMecanicaDb, "OficinaMecanicaDb", $techn="SQL Server 2022", $descr="Banco relacional da aplicacao, criado localmente por Docker Compose/Kubernetes e acessado via EF Core.", $tags="", $link="")
}

Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.ControllersHTTP, OficinaMecanicaAPI.OficinaMecanicaAPI.Segurancaemiddlewares, "Aplica autenticacao, autorizacao, Swagger e tratamento de erros", $techn="ASP.NET Core pipeline", $tags="", $link="")
Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.ControllersHTTP, OficinaMecanicaAPI.OficinaMecanicaAPI.ApplicationUseCases, "Invoca use cases", $techn="C# method calls", $tags="", $link="")
Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.ApplicationUseCases, OficinaMecanicaAPI.OficinaMecanicaAPI.DomainModel, "Executa regras de negocio", $techn="C# method calls", $tags="", $link="")
Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.ApplicationUseCases, OficinaMecanicaAPI.OficinaMecanicaAPI.Infrastructureadapters, "Usa repositories e Unit of Work via DI", $techn="C# interfaces / DI", $tags="", $link="")
Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.Infrastructureadapters, OficinaMecanicaAPI.OficinaMecanicaAPI.OficinaMecanicaDbContext, "Executa consultas e persistencia", $techn="Entity Framework Core", $tags="", $link="")
Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.OficinaMecanicaDbContext, OficinaMecanicaAPI.OficinaMecanicaDb, "Mapeia entidades e aplica migrations", $techn="EF Core / TDS", $tags="", $link="")
Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.Infrastructureadapters, OficinaMecanicaAPI.OficinaMecanicaAPI.DomainModel, "Materializa agregados e aplica contratos do dominio", $techn="C# references", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml