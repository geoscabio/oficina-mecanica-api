@startuml
title <size:24>Dynamic View: Oficina Mecanica API - OficinaMecanica.API</size>\n<size:24>Fluxo dinamico - abertura de ordem de servico com servicos e pecas opcionais.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

Person(Atendente, "Atendente", $descr="Cadastra clientes e veiculos, abre ordens de servico, envia orcamentos e registra entregas.", $tags="", $link="")

System_Boundary("OficinaMecanicaAPI_boundary", "Oficina Mecanica API", $tags="") {
  Container_Boundary("OficinaMecanicaAPI.OficinaMecanicaAPI_boundary", "OficinaMecanica.API", $tags="") {
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.OficinaMecanicaDbContext, "OficinaMecanicaDbContext", $techn="Entity Framework Core DbContext", $descr="Mapeia os agregados e entidades para tabelas SQL Server.", $tags="", $link="")
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.OrdensServicoController, "OrdensServicoController", $techn="ASP.NET Core Controller", $descr="Endpoint REST do fluxo principal de ordem de servico.", $tags="", $link="")
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.AbrirOrdemServicoUseCase, "AbrirOrdemServicoUseCase", $techn="C# use case", $descr="Valida cliente, veiculo, mecanico, catalogos e estoque antes de abrir uma OS.", $tags="", $link="")
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.OrdemServicoaggregate, "OrdemServico aggregate", $techn="C# aggregate", $descr="Controla transicoes de estado, orcamento, execucao, finalizacao, entrega e cancelamento.", $tags="", $link="")
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.Estoqueaggregate, "Estoque aggregate", $techn="C# aggregate", $descr="Controla disponibilidade, reserva, baixa, estorno e entrada de pecas/insumos.", $tags="", $link="")
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.Repositoryimplementations, "Repository implementations", $techn="EF Core repositories", $descr="Implementa repositories dos contextos Administrativo, Atendimento, Estoque e Ordem de Servico.", $tags="", $link="")
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.UnitOfWork, "UnitOfWork", $techn="EF Core transaction boundary", $descr="Confirma transacoes de persistencia envolvendo OS e estoque.", $tags="", $link="")
  }

  ContainerDb(OficinaMecanicaAPI.OficinaMecanicaDb, "OficinaMecanicaDb", $techn="SQL Server 2022", $descr="Banco relacional da aplicacao, criado localmente por Docker Compose/Kubernetes e acessado via EF Core.", $tags="", $link="")
}

Person(Atendente, "Atendente", $descr="Cadastra clientes e veiculos, abre ordens de servico, envia orcamentos e registra entregas.", $tags="", $link="")
ContainerDb(OficinaMecanicaAPI.OficinaMecanicaDb, "OficinaMecanicaDb", $techn="SQL Server 2022", $descr="Banco relacional da aplicacao, criado localmente por Docker Compose/Kubernetes e acessado via EF Core.", $tags="", $link="")

Rel(Atendente, OficinaMecanicaAPI.OficinaMecanicaAPI.OrdensServicoController, "1: POST /api/v1/gestao-ordem-servico/ordens-servico/cadastrar", $techn="HTTPS/JSON", $tags="", $link="")
Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.OrdensServicoController, OficinaMecanicaAPI.OficinaMecanicaAPI.AbrirOrdemServicoUseCase, "2: Executa abertura", $techn="C# method call", $tags="", $link="")
Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.AbrirOrdemServicoUseCase, OficinaMecanicaAPI.OficinaMecanicaAPI.Repositoryimplementations, "3: Valida cliente, veiculo, mecanico e catalogos", $techn="Repository interfaces", $tags="", $link="")
Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.Repositoryimplementations, OficinaMecanicaAPI.OficinaMecanicaAPI.OficinaMecanicaDbContext, "4: Consulta dados", $techn="Entity Framework Core", $tags="", $link="")
Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.AbrirOrdemServicoUseCase, OficinaMecanicaAPI.OficinaMecanicaAPI.Estoqueaggregate, "5: Verifica disponibilidade e reserva itens", $techn="C# domain calls", $tags="", $link="")
Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.AbrirOrdemServicoUseCase, OficinaMecanicaAPI.OficinaMecanicaAPI.OrdemServicoaggregate, "6: Cria OS e registra itens iniciais", $techn="C# domain calls", $tags="", $link="")
Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.AbrirOrdemServicoUseCase, OficinaMecanicaAPI.OficinaMecanicaAPI.UnitOfWork, "7: Confirma transacao", $techn="C# transaction boundary", $tags="", $link="")
Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.OficinaMecanicaDbContext, OficinaMecanicaAPI.OficinaMecanicaDb, "8: Persiste OS, itens e reservas", $techn="EF Core / TDS", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml