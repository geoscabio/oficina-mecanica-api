@startuml
title <size:24>Dynamic View: Oficina Mecanica API - OficinaMecanica.API</size>\n<size:24>Fluxo dinamico - decisao externa de orcamento.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

System(Canalexternodeorcamento, "Canal externo de orcamento", $descr="Canal externo usado para enviar orcamento ao cliente e notificar aprovacao ou recusa via webhook.", $tags="", $link="")

System_Boundary("OficinaMecanicaAPI_boundary", "Oficina Mecanica API", $tags="") {
  Container_Boundary("OficinaMecanicaAPI.OficinaMecanicaAPI_boundary", "OficinaMecanica.API", $tags="") {
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.Segurancaemiddlewares, "Seguranca e middlewares", $techn="ASP.NET Core middleware", $descr="Configura autenticacao JWT, autorizacao por perfis, token tecnico de webhook, Swagger e tratamento global de excecoes.", $tags="", $link="")
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.OficinaMecanicaDbContext, "OficinaMecanicaDbContext", $techn="Entity Framework Core DbContext", $descr="Mapeia os agregados e entidades para tabelas SQL Server.", $tags="", $link="")
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.OrdensServicoController, "OrdensServicoController", $techn="ASP.NET Core Controller", $descr="Endpoint REST do fluxo principal de ordem de servico.", $tags="", $link="")
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.NotificarDecisaoOrcamentoUseCase, "NotificarDecisaoOrcamentoUseCase", $techn="C# use case", $descr="Processa aprovacao ou recusa de orcamento recebida por webhook tecnico.", $tags="", $link="")
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.OrdemServicoaggregate, "OrdemServico aggregate", $techn="C# aggregate", $descr="Controla transicoes de estado, orcamento, execucao, finalizacao, entrega e cancelamento.", $tags="", $link="")
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.Estoqueaggregate, "Estoque aggregate", $techn="C# aggregate", $descr="Controla disponibilidade, reserva, baixa, estorno e entrada de pecas/insumos.", $tags="", $link="")
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.Repositoryimplementations, "Repository implementations", $techn="EF Core repositories", $descr="Implementa repositories dos contextos Administrativo, Atendimento, Estoque e Ordem de Servico.", $tags="", $link="")
    Component(OficinaMecanicaAPI.OficinaMecanicaAPI.UnitOfWork, "UnitOfWork", $techn="EF Core transaction boundary", $descr="Confirma transacoes de persistencia envolvendo OS e estoque.", $tags="", $link="")
  }

  ContainerDb(OficinaMecanicaAPI.OficinaMecanicaDb, "OficinaMecanicaDb", $techn="SQL Server 2022", $descr="Banco relacional da aplicacao, criado localmente por Docker Compose/Kubernetes e acessado via EF Core.", $tags="", $link="")
}

System(Canalexternodeorcamento, "Canal externo de orcamento", $descr="Canal externo usado para enviar orcamento ao cliente e notificar aprovacao ou recusa via webhook.", $tags="", $link="")
ContainerDb(OficinaMecanicaAPI.OficinaMecanicaDb, "OficinaMecanicaDb", $techn="SQL Server 2022", $descr="Banco relacional da aplicacao, criado localmente por Docker Compose/Kubernetes e acessado via EF Core.", $tags="", $link="")

Rel(Canalexternodeorcamento, OficinaMecanicaAPI.OficinaMecanicaAPI.OrdensServicoController, "1: POST /ordens-servico/{id}/orcamento/notificacoes com X-Webhook-Token", $techn="Webhook HTTP", $tags="", $link="")
Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.OrdensServicoController, OficinaMecanicaAPI.OficinaMecanicaAPI.Segurancaemiddlewares, "2: Valida token tecnico", $techn="ASP.NET Core filters/middleware", $tags="", $link="")
Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.OrdensServicoController, OficinaMecanicaAPI.OficinaMecanicaAPI.NotificarDecisaoOrcamentoUseCase, "3: Processa decisao", $techn="C# method call", $tags="", $link="")
Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.NotificarDecisaoOrcamentoUseCase, OficinaMecanicaAPI.OficinaMecanicaAPI.Repositoryimplementations, "4: Carrega OS e estoque", $techn="Repository interfaces", $tags="", $link="")
Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.NotificarDecisaoOrcamentoUseCase, OficinaMecanicaAPI.OficinaMecanicaAPI.OrdemServicoaggregate, "5: Aprova para execucao ou cancela por reprovacao", $techn="C# domain calls", $tags="", $link="")
Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.NotificarDecisaoOrcamentoUseCase, OficinaMecanicaAPI.OficinaMecanicaAPI.Estoqueaggregate, "6: Estorna reservas quando reprovado", $techn="C# domain calls", $tags="", $link="")
Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.NotificarDecisaoOrcamentoUseCase, OficinaMecanicaAPI.OficinaMecanicaAPI.UnitOfWork, "7: Confirma transacao", $techn="C# transaction boundary", $tags="", $link="")
Rel(OficinaMecanicaAPI.OficinaMecanicaAPI.OficinaMecanicaDbContext, OficinaMecanicaAPI.OficinaMecanicaDb, "8: Atualiza status e estoque", $techn="EF Core / TDS", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml