@startuml
title <size:24>Deployment View: Oficina Mecanica API - Kubernetes Local</size>\n<size:24>Deployment - Kubernetes local no Docker Desktop.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Deployment>

Deployment_Node(KubernetesLocal.Developerworkstation, "Developer workstation", $type="Windows / Docker Desktop", $descr="Estacao Windows com Docker Desktop Kubernetes.", $tags="", $link="") {
  Deployment_Node(KubernetesLocal.Developerworkstation.Clusterlocal, "Cluster local", $type="Kubernetes", $descr="Cluster Kubernetes do Docker Desktop.", $tags="", $link="") {
    Deployment_Node(KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina, "Namespace oficina", $type="Kubernetes Namespace", $descr="Namespace dedicado da aplicacao.", $tags="", $link="") {
      Deployment_Node(KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.PVCsqlserverpvc, "PVC sqlserver-pvc", $type="PersistentVolumeClaim", $descr="Volume persistente para dados do SQL Server.", $tags="", $link="")
      Deployment_Node(KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.Deploymentsqlserver, "Deployment sqlserver", $type="Kubernetes Deployment", $descr="Deployment do SQL Server 2022 Developer.", $tags="", $link="") {
        ContainerDb(KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.Deploymentsqlserver.OficinaMecanicaDb_1, "OficinaMecanicaDb", $techn="SQL Server 2022", $descr="Banco relacional da aplicacao, criado localmente por Docker Compose/Kubernetes e acessado via EF Core.", $tags="", $link="")
      }

      Deployment_Node(KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.Servicesqlserver, "Service sqlserver", $type="Kubernetes Service", $descr="Service interno para SQL Server.", $tags="", $link="")
      Deployment_Node(KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.Deploymentoficinaapi, "Deployment oficina-api", $type="Kubernetes Deployment", $descr="Deployment com startup, liveness e readiness probes em /api/health.", $tags="", $link="") {
        Container(KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.Deploymentoficinaapi.OficinaMecanicaAPI_1, "OficinaMecanica.API", $techn="ASP.NET Core Web API / .NET 10", $descr="Monolito modular ASP.NET Core que expoe endpoints REST, Swagger, autenticacao JWT, webhook de orcamento e inicializacao do banco.", $tags="", $link="")
      }

      Deployment_Node(KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.Serviceoficinaapi, "Service oficina-api", $type="Kubernetes Service", $descr="Service ClusterIP na porta 8080.", $tags="", $link="")
      Deployment_Node(KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.Ingressoficinaapi, "Ingress oficina-api", $type="NGINX Ingress", $descr="Roteia oficina.local para o service da API.", $tags="", $link="")
      Deployment_Node(KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.HPAoficinaapihpa, "HPA oficina-api-hpa", $type="HorizontalPodAutoscaler", $descr="Escala a API de 1 a 5 replicas por CPU e memoria.", $tags="", $link="")
    }

  }

}

Rel(KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.Deploymentsqlserver.OficinaMecanicaDb_1, KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.PVCsqlserverpvc, "Persiste dados", $techn="Volume mount", $tags="", $link="")
Rel(KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.Servicesqlserver, KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.Deploymentsqlserver.OficinaMecanicaDb_1, "Encaminha para Pod SQL Server", $techn="TDS", $tags="", $link="")
Rel(KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.Deploymentoficinaapi.OficinaMecanicaAPI_1, KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.Deploymentsqlserver.OficinaMecanicaDb_1, "Le e grava dados operacionais", $techn="EF Core / TDS", $tags="", $link="")
Rel(KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.Deploymentoficinaapi.OficinaMecanicaAPI_1, KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.Servicesqlserver, "Acessa banco por connection string em Secret", $techn="TDS", $tags="", $link="")
Rel(KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.Serviceoficinaapi, KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.Deploymentoficinaapi.OficinaMecanicaAPI_1, "Balanceia para Pods da API", $techn="HTTP", $tags="", $link="")
Rel(KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.Ingressoficinaapi, KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.Serviceoficinaapi, "Encaminha trafego HTTP", $techn="HTTP", $tags="", $link="")
Rel(KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.HPAoficinaapihpa, KubernetesLocal.Developerworkstation.Clusterlocal.Namespaceoficina.Deploymentoficinaapi.OficinaMecanicaAPI_1, "Ajusta replicas com base em CPU e memoria", $techn="Kubernetes metrics", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml