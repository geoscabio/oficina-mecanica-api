@startuml
title <size:24>Deployment View: Oficina Mecanica API - Local Docker Compose</size>\n<size:24>Deployment - execucao local via Docker Compose.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Deployment>

Deployment_Node(LocalDockerCompose.Developerworkstation, "Developer workstation", $type="Windows / Docker Desktop", $descr="Estacao Windows com Docker Desktop.", $tags="", $link="") {
  Deployment_Node(LocalDockerCompose.Developerworkstation.DockerCompose, "Docker Compose", $type="Docker Compose", $descr="Ambiente definido em docker-compose.yml.", $tags="", $link="") {
    Deployment_Node(LocalDockerCompose.Developerworkstation.DockerCompose.apiservice, "api service", $type="Docker container", $descr="Container oficina-mecanica-api expondo localhost:5093 -> 8080.", $tags="", $link="") {
      Container(LocalDockerCompose.Developerworkstation.DockerCompose.apiservice.OficinaMecanicaAPI_1, "OficinaMecanica.API", $techn="ASP.NET Core Web API / .NET 10", $descr="Monolito modular ASP.NET Core que expoe endpoints REST, Swagger, autenticacao JWT, webhook de orcamento e inicializacao do banco.", $tags="", $link="")
    }

    Deployment_Node(LocalDockerCompose.Developerworkstation.DockerCompose.sqlserverservice, "sqlserver service", $type="Docker container", $descr="Container oficina-mecanica-sqlserver expondo localhost:14333 -> 1433.", $tags="", $link="") {
      ContainerDb(LocalDockerCompose.Developerworkstation.DockerCompose.sqlserverservice.OficinaMecanicaDb_1, "OficinaMecanicaDb", $techn="SQL Server 2022", $descr="Banco relacional da aplicacao, criado localmente por Docker Compose/Kubernetes e acessado via EF Core.", $tags="", $link="")
    }

  }

}

Rel(LocalDockerCompose.Developerworkstation.DockerCompose.apiservice.OficinaMecanicaAPI_1, LocalDockerCompose.Developerworkstation.DockerCompose.sqlserverservice.OficinaMecanicaDb_1, "Le e grava dados operacionais", $techn="EF Core / TDS", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml