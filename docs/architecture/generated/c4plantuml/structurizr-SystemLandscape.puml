@startuml
title <size:24>System Landscape View</size>\n<size:24>Nivel 0 - paisagem de sistemas e plataformas relacionadas.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>

Person(Cliente, "Cliente", $descr="Consulta o status publico de uma ordem de servico.", $tags="", $link="")
