System(ImagemDockeroficinaapi, "Imagem Docker oficina-api", $descr="Artefato OCI gerado pelo Dockerfile multi-stage da API.", $tags="", $link="")

Rel(Atendente, OficinaMecanicaAPI, "Usa para atendimento, abertura de OS, aprovacoes e entrega", $techn="HTTPS/JSON", $tags="", $link="")
